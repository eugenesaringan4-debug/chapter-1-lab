class Student:
    def __init__(self, student_id, student_name, course, year_level):
        self.student_id = student_id
        self.student_name = student_name
        self.course = course
        self.year_level = year_level


class DynamicArray:
    def __init__(self):
        self.capacity = 5
        self.size = 0
        self.students = [None] * self.capacity

    # Add Student
    def add(self, student):
        if self.size == self.capacity:
            self.resize()

        self.students[self.size] = student
        self.size += 1

    # Resize the array
    def resize(self):
        new_capacity = self.capacity * 2
        new_students = [None] * new_capacity

        for i in range(self.size):
            new_students[i] = self.students[i]

        self.students = new_students
        self.capacity = new_capacity

        print(f"Array capacity increased to {self.capacity}.")

    # Display all students
    def display(self):
        if self.size == 0:
            print("\nNo students found.")
            return

        print("\n========== STUDENT RECORDS ==========")

        for i in range(self.size):
            student = self.students[i]

            print(f"\nStudent #{i + 1}")
            print(f"Student ID: {student.student_id}")
            print(f"Student Name: {student.student_name}")
            print(f"Course: {student.course}")
            print(f"Year Level: {student.year_level}")

        print("=====================================")

    # Search Student by ID
    def search(self, student_id):
        for i in range(self.size):
            if self.students[i].student_id == student_id:
                return self.students[i]

        return None

    # Update Student
    def update(self, student_id, student_name, course, year_level):
        student = self.search(student_id)

        if student is None:
            return False

        student.student_name = student_name
        student.course = course
        student.year_level = year_level

        return True

    # Remove Student
    def remove(self, student_id):
        index = -1

        # Find the student
        for i in range(self.size):
            if self.students[i].student_id == student_id:
                index = i
                break

        if index == -1:
            return False

        # Shift the remaining students
        for i in range(index, self.size - 1):
            self.students[i] = self.students[i + 1]

        # Remove the duplicate last element
        self.students[self.size - 1] = None

        self.size -= 1

        return True

    # Get current number of students
    def get_size(self):
        return self.size

    # Get current capacity
    def get_capacity(self):
        return self.capacity


def get_year_level():
    while True:
        try:
            year_level = int(input("Year Level: "))

            if year_level <= 0:
                print("Please enter a valid year level.")
            else:
                return year_level

        except ValueError:
            print("Please enter a number.")


def add_student(dynamic_array):
    print("\n========== ADD STUDENT ==========")

    student_id = input("Student ID: ").strip()

    # Check if ID already exists
    if dynamic_array.search(student_id) is not None:
        print("Student ID already exists.")
        return

    student_name = input("Student Name: ").strip()
    course = input("Course: ").strip()
    year_level = get_year_level()

    student = Student(
        student_id,
        student_name,
        course,
        year_level
    )

    dynamic_array.add(student)

    print("Student added successfully.")


def search_student(dynamic_array):
    print("\n========== SEARCH STUDENT ==========")

    student_id = input("Enter Student ID: ").strip()

    student = dynamic_array.search(student_id)

    if student is None:
        print("Student not found.")
        return

    print("\nStudent found!")
    print(f"Student ID: {student.student_id}")
    print(f"Student Name: {student.student_name}")
    print(f"Course: {student.course}")
    print(f"Year Level: {student.year_level}")


def update_student(dynamic_array):
    print("\n========== UPDATE STUDENT ==========")

    student_id = input("Enter Student ID: ").strip()

    student = dynamic_array.search(student_id)

    if student is None:
        print("Student not found.")
        return

    print("\nCurrent Information:")
    print(f"Student ID: {student.student_id}")
    print(f"Student Name: {student.student_name}")
    print(f"Course: {student.course}")
    print(f"Year Level: {student.year_level}")

    print("\nEnter New Information:")

    student_name = input("Student Name: ").strip()
    course = input("Course: ").strip()
    year_level = get_year_level()

    dynamic_array.update(
        student_id,
        student_name,
        course,
        year_level
    )

    print("Student updated successfully.")


def remove_student(dynamic_array):
    print("\n========== REMOVE STUDENT ==========")

    student_id = input("Enter Student ID: ").strip()

    if dynamic_array.remove(student_id):
        print("Student removed successfully.")
    else:
        print("Student not found.")


def display_array_information(dynamic_array):
    print("\n========== ARRAY INFORMATION ==========")
    print(f"Number of Students: {dynamic_array.get_size()}")
    print(f"Array Capacity: {dynamic_array.get_capacity()}")
    print("=======================================")


def main():
    dynamic_array = DynamicArray()

    while True:
        print("\n")
        print("================================")
        print("     STUDENT RECORD MANAGER")
        print("================================")
        print("1. Add Student")
        print("2. Display Students")
        print("3. Search Student")
        print("4. Update Student")
        print("5. Remove Student")
        print("6. Display Array Information")
        print("7. Exit")
        print("================================")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            add_student(dynamic_array)

        elif choice == "2":
            dynamic_array.display()

        elif choice == "3":
            search_student(dynamic_array)

        elif choice == "4":
            update_student(dynamic_array)

        elif choice == "5":
            remove_student(dynamic_array)

        elif choice == "6":
            display_array_information(dynamic_array)

        elif choice == "7":
            print("Thank you for using Student Record Manager!")
            break

        else:
            print("Invalid choice. Please select 1-7.")


if __name__ == "__main__":
    main()
